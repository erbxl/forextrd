generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id
  name            String           @default("Estudiante")
  weeklyGoal      Int              @default(3)
  lastStudyAt     DateTime?
  createdAt       DateTime         @default(now())
  progress        LessonProgress[]
  attempts        Attempt[]
  activity        DailyActivity[]
  studySessions   StudySession[]
}

model AcademyModule {
  id          Int      @id
  title       String
  description String
  status      String   @default("planned")
  lessons     Lesson[]
}

model Lesson {
  slug            String           @id
  title           String
  moduleId        Int
  durationMinutes Int
  published       Boolean          @default(false)
  module          AcademyModule    @relation(fields: [moduleId], references: [id])
  questions       Question[]
  progress        LessonProgress[]
  attempts        Attempt[]
}

model Question {
  id          String            @id
  lessonSlug  String
  type        String
  concept     String
  definition  String
  lesson      Lesson            @relation(fields: [lessonSlug], references: [slug], onDelete: Cascade)
  outcomes    QuestionOutcome[]

  @@index([lessonSlug])
}

model LessonProgress {
  userId      String
  lessonSlug  String
  readAt      DateTime?
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonSlug], references: [slug], onDelete: Cascade)

  @@id([userId, lessonSlug])
}

model Attempt {
  id           String            @id @default(cuid())
  userId       String
  lessonSlug   String
  score        Int
  passed       Boolean
  correctCount Int
  totalCount   Int
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson            @relation(fields: [lessonSlug], references: [slug], onDelete: Cascade)
  outcomes     QuestionOutcome[]

  @@index([userId, createdAt])
  @@index([userId, lessonSlug])
}

model QuestionOutcome {
  id           String   @id @default(cuid())
  attemptId    String
  questionId   String
  concept      String
  correct      Boolean
  submitted    String
  correctValue String
  explanation  String
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model DailyActivity {
  userId       String
  date         String
  studySeconds Int    @default(0)
  attempts     Int    @default(0)
  completions  Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  startedAt       DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastHeartbeatAt])
}
